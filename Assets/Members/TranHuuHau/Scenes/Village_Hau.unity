--- !u!114 &869032969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 869032967}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Dam
  roleTitle: "Ch\u1ED3ng - Ng\u01B0\u1EDDi g\xE1c c\u1ED5ng l\xE0ng (Gia \u0111\xECnh 3)"
  portraitSprite: {fileID: 21300000, guid: 56e69c321f34fdd52885ffd9f06be523, type: 3}
  dialogueLines:
  - "Ch\xE0o c\u1EADu b\u1EA1n! Ta l\xE0 Dam, ph\u1EE5 tr\xE1ch canh gi\u1EEF l\u1ED1i m\xF2n duy nh\u1EA5t d\u1EABn qua d\xE3y n\xFAi ra th\u1EBF gi\u1EDBi b\xEAn ngo\xE0i."
  - "Ng\xF4i l\xE0ng Londo \u0111\u1ECBa th\u1EBF hi\u1EC3m tr\u1EDF b\u1ED1n b\u1EC1 v\xE1ch \u0111\xE1, th\u01B0\u01A1ng nh\xE2n ph\u01B0\u01A1ng xa x\u01B0a nay hi\u1EBFm ai mu\u1ED1n \u0111\u1EB7t ch\xE2n t\u1EDBi."
  - "Nh\u01B0ng g\u1EA7n \u0111\xE2y h\u01B0\u01A1ng v\u1ECB m\xF3n \u0103n k\u1EF3 l\u1EA1 th\u01A1m n\u1EE9c m\u0169i c\u1EE7a c\u1EADu \u0111\xE3 bay xa r\u1ED3i \u0111\u1EA5y!"
  - "M\u1EA5y h\xF4m tr\u01B0\u1EDBc ta th\u1EA5y c\xF3 v\xE0i th\u01B0\u01A1ng bu\xF4n gi\xE0u c\xF3 gh\xE9 h\u1ECFi th\u0103m \u0111\u01B0\u1EDDng v\xE0o l\xE0ng. Ti\u1EC7m \u0103n c\u1EE7a c\u1EADu s\u1EAFp \u0111\xF3n kh\xE1ch qu\xFD r\u1ED3i!"
  interactRange: 2.2
