MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1971396627}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Gam
  roleTitle: "Ch\u1ED3ng - C\u1EF1u th\u1EE3 r\xE8n ki\xEAm d\xE2n qu\xE2n (Gia \u0111\xECnh 2)"
  portraitSprite: {fileID: 21300000, guid: 6c6033411ba51f2f9bda445d6776d7ff, type: 3}
  dialogueLines:
  - "Ha ha ha! C\u1EADu em \u0111\u1EA7u b\u1EBFp qu\u1EA3 c\u1EA3m! Ta l\xE0 Gam, ch\u1EE7 c\u0103n nh\xE0 s\u1ED1 2."
  - "N\u0103m ngo\xE1i ta t\u1EEBng v\xE1c b\xFAa l\u1EDBn t\xEDnh li\u1EC1u m\xECnh xu\u1ED1ng h\u1EA7m ng\u1EE5c ki\u1EBFm ch\xFAt th\u1ECBt r\u1EEBng, nh\u01B0ng l\u0169 qu\xE1i x\u01B0\u01A1ng cung th\u1EE7 b\u1EAFn d\u1EEF d\u1ED9i qu\xE1, \u0111\xE0nh \xF4m v\u1EBFt th\u01B0\u01A1ng b\u1ECF ch\u1EA1y."
  - "Th\u1EA5y c\u1EADu m\u1ED9t m\xECnh vung ki\u1EBFm h\u1EA1 g\u1EE5c l\u0169 qu\xE1i hung h\xE3n, ta th\u1EF1c s\u1EF1 n\u1EC3 ph\u1EE5c!"
  - "L\xFAc n\xE0o r\u1EA3nh r\u1ED7i gh\xE9 qua ta, ta s\u1EBD ch\u1EC9 cho v\xE0i m\u1EB9o r\xE8n gi\u0169a l\u01B0\u1EE1i ki\u1EBFm b\xE9n ng\xF3t \u0111\u1EC3 ch\xE9m qu\xE1i ng\u1ECDt h\u01A1n!"
  interactRange: 2.2
