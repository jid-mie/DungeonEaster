  m_GameObject: {fileID: 280799212}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Sam
  roleTitle: "Ch\u1ED3ng - Ti\u1EC1u phu & N\xF4ng d\xE2n (Gia \u0111\xECnh 1)"
  portraitSprite: {fileID: 21300000, guid: c57cb5e30f0e62079b945d4375a3280f, type: 3}
  dialogueLines:
  - "Ch\xE0o c\u1EADu \u0111\u1EA7u b\u1EBFp d\u0169ng c\u1EA3m! T\xF4i l\xE0 Sam, s\u1ED1ng c\xF9ng v\u1EE3 Nana v\xE0 b\xE9 Leaf b\xEAn c\u0103n nh\xE0 g\u1ED7 n\xE0y."
  - "T\u1EEB ng\xE0y ch\u01B0\u1EDBng kh\xED \u0111\u1ED9c h\u1EA1i t\u1EEB ng\u1EE5c t\u1ED1i tr\xE0n l\xEAn, hoa m\xE0u tr\xEAn c\xE1nh \u0111\u1ED3ng \u0111\u1EC1u ch\u1EBFt r\u0169 h\u1EBFt c\u1EA3."
  - "Tr\u01B0\u1EDBc \u0111\xE2y c\u1EA3 nh\xE0 t\xF4i ph\u1EA3i nhai v\u1ECF c\xE2y qua ng\xE0y... May nh\u1EDD c\xF3 qu\xE1n \u0103n c\u1EE7a c\u1EADu m\u1EDF ra c\u1EE9u r\u1ED7i gia \u0111\xECnh t\xF4i."
  - "Th\u1ECBt n\u01B0\u1EDBng x\xF4ng kh\xF3i c\u1EADu l\xE0m \u0111\u1EADm v\u1ECB th\u1EADt \u0111\u1EA5y, \u0103n m\u1ED9t mi\u1EBFng l\xE0 t\xF4i v\xE1c r\xECu \u0111\u1ED1n c\u1EE7i c\u1EA3 ng\xE0y kh\xF4ng bi\u1EBFt m\u1EC7t!"
  interactRange: 2.2
