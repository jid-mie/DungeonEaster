  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "Tr\u01B0\u1EDFng l\xE0ng Godwin"
  roleTitle: "L\xE3o tr\u01B0\u1EDFng l\xE0ng Londo"
  portraitSprite: {fileID: 21300000, guid: ab324e5407f9e74d8ac81c0f945851b6, type: 3}
  dialogueLines:
  - "Ch\xE0o m\u1EEBng c\u1EADu d\u0169ng s\u0129 \u0111\xE3 tr\u1EDF v\u1EC1 b\xECnh an t\u1EEB l\xF2ng h\u1EA7m ng\u1EE5c!"
  - "Ng\xF4i l\xE0ng Londo ngh\xE8o kh\xF3 n\xE0y mang \u01A1n c\u1EE9u m\u1EA1ng c\u1EE7a c\u1EADu r\u1EA5t nhi\u1EC1u."
  - "Nh\u1EDD c\xF3 c\xE1c m\xF3n \u0103n ngon l\xE0nh b\u1ED5 d\u01B0\u1EE1ng t\u1EEB nguy\xEAn li\u1EC7u qu\xE1i v\u1EADt c\u1EE7a c\u1EADu, d\xE2n l\xE0ng ta m\u1EDBi d\u1EA7n h\u1ED3i ph\u1EE5c s\u1EE9c s\u1ED1ng."
  - "Ta \u0111\xE3 \u0111\u1EC3 l\u1EA1i c\u0103n nh\xE0 hoang cho c\u1EADu l\xE0m qu\xE1n \u0103n, hy v\u1ECDng c\u1EADu s\u1EBD ti\u1EBFp t\u1EE5c g\u1EAFn b\xF3 c\xF9ng ng\xF4i l\xE0ng."
  - "C\u1EA7n mua b\xECnh m\xE1u, l\u1EF1u \u0111\u1EA1n n\u1ED5 hay d\u01B0\u1EE3c th\u1EA3o th\xEC c\u1EE9 b\u01B0\u1EDBc v\xE0o ti\u1EC7m thu\u1ED1c c\u1EE7a ta ngay \u0111\u1EB1ng sau nh\xE9!"
  interactRange: 2.2
