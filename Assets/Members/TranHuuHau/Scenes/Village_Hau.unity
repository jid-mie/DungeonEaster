  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Vini
  roleTitle: "Con g\xE1i nh\u1ECF nh\xFAt nh\xE1t (Gia \u0111\xECnh 3)"
  portraitSprite: {fileID: 21300000, guid: 62693c00429a2eaeea36fa37360266ae, type: 3}
  dialogueLines:
  - "...D\u1EA1... em ch\xE0o anh \u0111\u1EA7u b\u1EBFp \u1EA1... Em l\xE0 Vini..."
  - "M\u1ED7i l\u1EA7n nh\xECn l\xEAn ng\u1ECDn n\xFAi s\u01B0\u01A1ng m\xF9 n\u01A1i mi\u1EC7ng hang h\u1EA7m ng\u1EE5c, em \u0111\u1EC1u th\u1EA5y l\u1EA1nh s\u1ED1ng l\u01B0ng v\xE0 s\u1EE3 h\xE3i..."
  - "Nh\u01B0ng th\u1EA5y anh tr\u1EDF v\u1EC1 an to\xE0n v\u1EDBi n\u1EE5 c\u01B0\u1EDDi tr\xEAn m\xF4i, em th\u1EA5y l\xF2ng nh\u1EB9 nh\xF5m h\u01A1n nhi\u1EC1u."
  - "Anh v\xE0o ng\u1EE5c t\u1ED1i nh\u1EDB c\u1EA9n th\u1EADn b\u1EABy ch\xF4ng s\xE0n nh\xE0 nh\xE9... Em ch\xFAc anh lu\xF4n b\xECnh an!"
  interactRange: 2.2
