  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Vincent
  roleTitle: "Con trai - Thi\u1EBFu ni\xEAn t\u1EADp s\u1EF1 (Gia \u0111\xECnh 2)"
  portraitSprite: {fileID: 21300000, guid: 6c6033411ba51f2f9bda445d6776d7ff, type: 3}
  dialogueLines:
  - "Ch\xE0o anh \u0111\u1EA7u b\u1EBFp! Em l\xE0 Vincent, con trai c\u1EE7a b\u1ED1 Gam!"
  - "Em \u0111ang ng\xE0y \u0111\xEAm luy\u1EC7n t\u1EADp k\u1EF9 thu\u1EADt ch\xE9m ki\u1EBFm h\xECnh cung v\xE0 l\u0103n x\u1EA3 n\xE9 \u0111\xF2n nh\u01B0 anh \u0111\u1EA5y!"
  - "Anh k\u1EC3 cho em nghe v\u1EC1 Boss R\u1EAFn kh\u1ED5ng l\u1ED3 \u1EDF t\u1EA7ng 1 \u0111i! N\xF3 c\xF3 phun n\u1ECDc \u0111\u1ED9c kh\xF4ng anh?"
  - "L\u1EDBn l\xEAn em nh\u1EA5t \u0111\u1ECBnh s\u1EBD tr\u1EDF th\xE0nh m\u1ED9t d\u0169ng s\u0129 thi\u1EC7n chi\u1EBFn nh\u01B0 anh, c\xF9ng anh xu\u1ED1ng t\u1EA7ng 5 \u0111\xE1nh b\u1EA1i th\u1EA7n Gwyn \u0111\u1EC3 gi\u1EA3i tho\xE1t cho ng\xF4i l\xE0ng!"
  interactRange: 2.2
