  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8536576427ffcc242846314e731f8790, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Sana
  roleTitle: "V\u1EE3 - Th\u1EA7y thu\u1ED1c th\u1EA3o m\u1ED9c (Gia \u0111\xECnh 3)"
  portraitSprite: {fileID: 21300000, guid: c57cb5e30f0e62079b945d4375a3280f, type: 3}
  dialogueLines:
  - "Ch\xE0o c\u1EADu th\u1EE3 s\u0103n - \u0111\u1EA7u b\u1EBFp! T\xF4i l\xE0 Sana, v\u1EE3 c\u1EE7a Dam."
  - "T\xF4i chuy\xEAn h\xE1i l\u01B0\u1EE3m v\xE0 nghi\xEAn c\u1EE9u c\xE1c lo\u1EA1i r\xEAu l\u1ECDc \u0111\u1ED9c c\xF9ng c\u1ECF d\u01B0\u1EE3c quanh b\xECa r\u1EEBng."
  - "\xC1m kh\xED dungeon r\u1EA5t \u0111\u1ED9c h\u1EA1i, nh\u01B0ng nh\u1EDD c\u1EADu ti\xEAu di\u1EC7t b\u1EDBt qu\xE1i v\u1EADt n\xEAn ch\xFAng t\xF4i m\u1EDBi an t\xE2m h\xE1i thu\u1ED1c."
  - "N\u1EBFu nh\u1EB7t \u0111\u01B0\u1EE3c c\u1EE7 r\xEAu l\u1ECDc \u0111\u1ED9c \u1EDF t\u1EA7ng \u0111\u1EA7m l\u1EA7y, h\xE3y nh\u1EDB gi\u1EEF l\u1EA1i nh\xE9, n\xF3 c\xF3 th\u1EC3 trung h\xF2a v\u1ECB \u0111\u1EAFng v\xE0 kh\u1EED \u0111\u1ED9c m\xF3n \u0103n r\u1EA5t t\u1ED1t \u0111\u1EA5y!"
  interactRange: 2.2
